# =============================================================================
# IBVAP — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=IBVAP
APP_ENV=development
# development | test | production
APP_SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_VERSION=v1

# ── Database ──────────────────────────────────────────────────────────────────
# Development: SQLite
DATABASE_URL=sqlite:///./ibvap_dev.db

# Production (PostgreSQL example — never commit real credentials):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ibvap_prod

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Camera Configuration ──────────────────────────────────────────────────────
# Real camera credentials must NEVER be hardcoded.
# Reference the cameras.yaml config file instead.
CAMERAS_CONFIG_PATH=configs/cameras.yaml

# ── MediaMTX (Development RTSP Simulator) ────────────────────────────────────
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_PORT=8554

# ── Detection Engine ──────────────────────────────────────────────────────────
DETECTION_MODEL=yolov8n
DETECTION_MODEL_PATH=ml/models/weights/yolov8n.pt
DETECTION_DEVICE=cpu
# cpu | cuda (only if NVIDIA GPU available)
DETECTION_CONFIDENCE_THRESHOLD=0.4
DETECTION_INPUT_SIZE=640

# ── Tracking ──────────────────────────────────────────────────────────────────
TRACKING_MAX_AGE=30
TRACKING_MIN_HITS=3
TRACKING_IOU_THRESHOLD=0.3

# ── ANPR ──────────────────────────────────────────────────────────────────────
ANPR_ENABLED=false
ANPR_OCR_CONFIDENCE_THRESHOLD=0.6
ANPR_TRIGGER_INTERVAL_FRAMES=10

# ── Evidence Storage ──────────────────────────────────────────────────────────
EVIDENCE_STORAGE_PATH=data/incidents
EVIDENCE_RETENTION_DAYS=90

# ── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ibvap-detection

# ── Security ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=100

# ── Optional: NVIDIA ──────────────────────────────────────────────────────────
# Only set if NVIDIA GPU is available (not needed for CPU-only setup)
# CUDA_DEVICE_ID=0
# TENSORRT_CACHE_PATH=infrastructure/nvidia/trt_cache
